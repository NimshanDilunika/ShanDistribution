@model IEnumerable<ShanDistribution.Models.Customer>
@{
    ViewData["Title"] = "Customers";
}

<div class="container-fluid px-0 mt-4">
    <!-- Header Banner -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white border-start border-4 border-success">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <div>
                    <h4 class="fw-bold mb-1 text-dark">
                        <i class="bi bi-people-fill text-success me-2"></i>Customers Directory
                    </h4>
                    <span class="text-muted small">Manage retail outlets, wholesale sweet shops, and distribution points</span>
                </div>
                <div class="mt-3 mt-md-0">
                    <a asp-action="Create" class="btn btn-success fw-semibold px-3 py-2" style="background-color: #15803d;">
                        <i class="bi bi-person-plus-fill me-1"></i> Add Customer
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-body p-3">
            <div class="row align-items-center g-2">
                <div class="col-12 col-md-8 col-lg-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="customerSearchInput" class="form-control border-start-0 bg-light" 
                               placeholder="Search customers by name, address, or phone..." onkeyup="filterCustomers()">
                    </div>
                </div>
                <div class="col-12 col-md-4 col-lg-6 text-md-end text-muted small">
                    Showing <span id="visibleCount" class="fw-bold text-dark">@(Model?.Count() ?? 0)</span> customers
                </div>
            </div>
        </div>
    </div>

    <!-- Customer Cards Grid -->
    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 bg-white p-5 text-center">
            <div class="text-muted">
                <i class="bi bi-people text-secondary fs-1 d-block mb-2"></i>
                <h6 class="fw-bold">No Customers Found</h6>
                <p class="small mb-3">There are no customers or outlets registered in the system yet.</p>
                <a asp-action="Create" class="btn btn-sm btn-outline-success">
                    <i class="bi bi-plus-lg me-1"></i> Add First Customer
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4" id="customerCardsContainer">
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-xl-4 customer-card" 
                     data-name="@(item.CustomerName?.ToLower() ?? "")"
                     data-address="@(item.Address?.ToLower() ?? "")"
                     data-phone="@(item.PhoneNo?.ToLower() ?? "")">
                    <div class="card border-0 shadow-sm rounded-3 bg-white h-100 position-relative">
                        <div class="card-body p-4 d-flex flex-column">
                            <!-- Customer Identity Header -->
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle p-3 text-white me-3" style="background-color: #14532d;">
                                        <i class="bi bi-shop fs-5"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-0 customer-title">@item.CustomerName</h5>
                                        <span class="badge bg-light text-secondary border mt-1">ID: #@item.CustomerId</span>
                                    </div>
                                </div>
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                                    Active Outlet
                                </span>
                            </div>

                            <hr class="text-muted my-2" />

                            <!-- Customer Details -->
                            <div class="my-3 small">
                                <div class="d-flex align-items-center mb-2 text-secondary">
                                    <i class="bi bi-geo-alt text-success me-2 fs-6"></i>
                                    <span>@(string.IsNullOrWhiteSpace(item.Address) ? "No address registered" : item.Address)</span>
                                </div>
                                <div class="d-flex align-items-center text-secondary">
                                    <i class="bi bi-telephone text-success me-2 fs-6"></i>
                                    <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(item.PhoneNo) ? "No contact number" : item.PhoneNo)</span>
                                </div>
                            </div>

                            <!-- Card Action Buttons -->
                            <div class="mt-auto pt-3 border-top d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-info flex-grow-1 fw-semibold">
                                    <i class="bi bi-info-circle me-1"></i> Details
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-success flex-grow-1 fw-semibold">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Delete" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-danger px-3">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- No Matching Search Results State -->
        <div id="noMatchMessage" class="card border-0 shadow-sm rounded-3 bg-white p-5 text-center d-none mt-3">
            <div class="text-muted">
                <i class="bi bi-search text-secondary fs-1 d-block mb-2"></i>
                <h6 class="fw-bold">No Matching Customers Found</h6>
                <p class="small mb-0">Try searching with a different outlet name, route, or phone number.</p>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function filterCustomers() {
            const query = document.getElementById('customerSearchInput').value.toLowerCase().trim();
            const cards = document.querySelectorAll('.customer-card');
            let visible = 0;

            cards.forEach(card => {
                const name = card.getAttribute('data-name') || '';
                const address = card.getAttribute('data-address') || '';
                const phone = card.getAttribute('data-phone') || '';

                if (name.includes(query) || address.includes(query) || phone.includes(query)) {
                    card.style.display = '';
                    visible++;
                } else {
                    card.style.display = 'none';
                }
            });

            document.getElementById('visibleCount').innerText = visible;

            const noMatch = document.getElementById('noMatchMessage');
            if (noMatch) {
                if (visible === 0 && cards.length > 0) {
                    noMatch.classList.remove('d-none');
                } else {
                    noMatch.classList.add('d-none');
                }
            }
        }
    </script>
}