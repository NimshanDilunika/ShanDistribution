@model ShanDistribution.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Operational Dashboard";
}

<div class="container-fluid px-0">
    <!-- Header Banner -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white border-start border-4 border-success">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <div>
                    <h4 class="fw-bold mb-1 text-dark">
                        <i class="bi bi-speedometer2 text-success me-2"></i>ShanDistribution Operational Dashboard
                    </h4>
                    <span class="text-muted small">Real-time islandwide distribution metrics, inventory health & customer performance</span>
                </div>
                <div class="d-flex align-items-center gap-2 mt-3 mt-md-0">
                    <span class="badge bg-light text-secondary border px-3 py-2">
                        <i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dddd, MMM dd, yyyy")
                    </span>
                    <span class="badge px-3 py-2 fw-semibold" style="background-color: #dcfce7; color: #15803d; border: 1px solid #bbf7d0;">
                        <i class="bi bi-circle-fill small me-1"></i> Operational
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- 5 Real Key Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-semibold">Active Customers</span>
                            <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalActiveCustomers.ToString("N0")</h3>
                            <small class="text-muted">Registered Outlets</small>
                        </div>
                        <div class="rounded-circle p-3 text-white" style="background-color: #14532d;">
                            <i class="bi bi-people-fill fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-semibold">Customer Invoices</span>
                            <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalInvoicesCount.ToString("N0")</h3>
                            <small class="text-warning fw-bold">Total Processed</small>
                        </div>
                        <div class="rounded-circle p-3 text-white" style="background-color: #ca8a04;">
                            <i class="bi bi-receipt-cutoff fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-semibold">Active Products</span>
                            <h3 class="fw-bold text-dark mt-1 mb-0">@Model.ActiveProductsCount.ToString("N0")</h3>
                            <small class="text-muted">Sweet Catalog SKUs</small>
                        </div>
                        <div class="rounded-circle p-3 text-white" style="background-color: #15803d;">
                            <i class="bi bi-boxes fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-semibold">Total Suppliers</span>
                            <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalActiveSuppliers.ToString("N0")</h3>
                            <small class="text-muted">Active Partners</small>
                        </div>
                        <div class="rounded-circle p-3 text-white" style="background-color: #0f766e;">
                            <i class="bi bi-truck fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-semibold">Supplier Bills</span>
                            <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalBillsCount.ToString("N0")</h3>
                            <small class="text-danger fw-bold">Total Inward</small>
                        </div>
                        <div class="rounded-circle p-3 text-white" style="background-color: #991b1b;">
                            <i class="bi bi-journal-text fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Product Analytics: Low Stock & High-Selling Products -->
    <div class="row g-4 mb-4">
        <!-- Low Stock Products -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Low Stock Inventory Alert
                    </h6>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Reorder Level</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">ID</th>
                                    <th>Product Name</th>
                                    <th class="text-end">Unit Price (LKR)</th>
                                    <th class="text-end pe-3">Stock Remaining</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.LowStockProducts != null && Model.LowStockProducts.Any())
                                {
                                    @foreach (var prod in Model.LowStockProducts)
                                    {
                                        <tr>
                                            <td class="ps-3 text-muted">#@prod.ProductId</td>
                                            <td class="fw-semibold text-dark">@prod.ProductName</td>
                                            <td class="text-end">@prod.Price.ToString("N2")</td>
                                            <td class="text-end pe-3">
                                                <span class="badge bg-danger text-white">@prod.StockCount Units</span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">All sweet products have sufficient stock levels.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- High-Selling Products -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-star-fill text-warning me-2"></i>Top-Selling Sweet Products
                    </h6>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">High Demand</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">ID</th>
                                    <th>Product Name</th>
                                    <th class="text-center">Times Invoiced</th>
                                    <th class="text-end pe-3">Est. Value (LKR)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.TopSellingProducts != null && Model.TopSellingProducts.Any())
                                {
                                    @foreach (var top in Model.TopSellingProducts)
                                    {
                                        <tr>
                                            <td class="ps-3 text-muted">#@top.ProductId</td>
                                            <td class="fw-semibold text-dark">@top.ProductName</td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border">@top.TotalUnitsSold</span>
                                            </td>
                                            <td class="text-end pe-3 fw-bold text-success">
                                                @top.TotalRevenue.ToString("N2")
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">No sales invoice history recorded yet.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Customer Performance: Top-Selling vs Low-Selling Customers -->
    <div class="row g-4">
        <!-- Low-Selling Customers -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-person-x-fill text-secondary me-2"></i>Low-Selling Customers (Low/Zero Volume)
                    </h6>
                    <span class="badge bg-light text-secondary border">Needs Follow-Up</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Customer ID</th>
                                    <th>Customer Name</th>
                                    <th class="text-end pe-3">Total Invoices</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.LowSellingCustomers != null && Model.LowSellingCustomers.Any())
                                {
                                    @foreach (var cust in Model.LowSellingCustomers)
                                    {
                                        <tr>
                                            <td class="ps-3 text-muted">#@cust.CustomerId</td>
                                            <td class="fw-semibold text-dark">@cust.CustomerName</td>
                                            <td class="text-end pe-3">
                                                <span class="badge bg-secondary text-white">@cust.TotalInvoices Invoices</span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-4">No customer data available.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- Top-Selling Customers -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-award-fill text-success me-2"></i>Top-Selling Customers (High Volume)
                    </h6>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Frequent Buyers</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Customer ID</th>
                                    <th>Customer Name</th>
                                    <th class="text-end pe-3">Total Invoices</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.TopSellingCustomers != null && Model.TopSellingCustomers.Any())
                                {
                                    @foreach (var cust in Model.TopSellingCustomers)
                                    {
                                        <tr>
                                            <td class="ps-3 text-muted">#@cust.CustomerId</td>
                                            <td class="fw-semibold text-dark">@cust.CustomerName</td>
                                            <td class="text-end pe-3">
                                                <span class="badge bg-success text-white">@cust.TotalInvoices Invoices</span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-4">No customer transactions recorded yet.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>