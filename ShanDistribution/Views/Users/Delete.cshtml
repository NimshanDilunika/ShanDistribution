@model ShanDistribution.ViewModels.UserListViewModel
@{
    ViewData["Title"] = "Delete User";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Delete User</h4>
                    <a asp-action="Index" class="btn btn-outline-light btn-sm">Back to List</a>
                </div>
                <div class="card-body p-4">
                    <h5 class="text-danger">Are you sure you want to delete this user?</h5>
                    <p class="text-muted">This action cannot be undone.</p>
                    <hr />

                    <dl class="row">
                        <dt class="col-sm-4">Full Name</dt>
                        <dd class="col-sm-8 fw-bold">@Model.FullName</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Phone</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "N/A" : Model.PhoneNumber)</dd>

                        <dt class="col-sm-4">Role</dt>
                        <dd class="col-sm-8">
                            @foreach (var role in Model.Roles)
                            {
                                <span class="badge bg-success">@role</span>
                            }
                        </dd>
                    </dl>

                    <form asp-action="Delete" method="post" class="d-flex justify-content-between mt-4">
                        <input type="hidden" asp-for="Id" />
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>