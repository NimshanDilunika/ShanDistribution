@model IEnumerable<ShanDistribution.ViewModels.UserListViewModel>
@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid px-0 mt-4">
    <!-- Header Banner -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white border-start border-4 border-success">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <div>
                    <h4 class="fw-bold mb-1 text-dark">
                        <i class="bi bi-people-fill text-success me-2"></i>System Users Directory
                    </h4>
                    <span class="text-muted small">Manage administrative staff, inventory clerks, and sales representatives</span>
                </div>
                <div class="mt-3 mt-md-0">
                    <a asp-action="Create" class="btn btn-success fw-semibold px-3 py-2" style="background-color: #15803d;">
                        <i class="bi bi-person-plus-fill me-1"></i> Add New User
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-body p-3">
            <div class="row align-items-center g-2">
                <div class="col-12 col-md-8 col-lg-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="userSearchInput" class="form-control border-start-0 bg-light" 
                               placeholder="Search users by name, email, phone, or role..." onkeyup="filterUsers()">
                    </div>
                </div>
                <div class="col-12 col-md-4 col-lg-6 text-md-end text-muted small">
                    Showing <span id="visibleCount" class="fw-bold text-dark">@(Model?.Count() ?? 0)</span> system users
                </div>
            </div>
        </div>
    </div>

    <!-- User Cards Grid -->
    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 bg-white p-5 text-center">
            <div class="text-muted">
                <i class="bi bi-people text-secondary fs-1 d-block mb-2"></i>
                <h6 class="fw-bold">No Users Found</h6>
                <p class="small mb-3">There are no system users registered in the directory yet.</p>
                <a asp-action="Create" class="btn btn-sm btn-outline-success">
                    <i class="bi bi-plus-lg me-1"></i> Add First User
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4" id="userCardsContainer">
            @foreach (var user in Model)
            {
                var rolesString = user.Roles != null ? string.Join(" ", user.Roles).ToLower() : "";
                <div class="col-12 col-md-6 col-xl-4 user-card" 
                     data-name="@(user.FullName?.ToLower() ?? "")"
                     data-email="@(user.Email?.ToLower() ?? "")"
                     data-phone="@(user.PhoneNumber?.ToLower() ?? "")"
                     data-roles="@rolesString">
                    <div class="card border-0 shadow-sm rounded-3 bg-white h-100 position-relative">
                        <div class="card-body p-4 d-flex flex-column">
                            <!-- User Identity Header -->
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle p-3 text-white me-3" style="background-color: #14532d;">
                                        <i class="bi bi-person-badge fs-5"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-0 user-title">@user.FullName</h5>
                                        <span class="badge bg-light text-secondary border mt-1">
                                            @if (user.Roles != null && user.Roles.Any())
                                            {
                                                @string.Join(", ", user.Roles)
                                            }
                                            else
                                            {
                                                <text>Standard User</text>
                                            }
                                        </span>
                                    </div>
                                </div>
                                @if (user.Email == User.Identity?.Name)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                                        Current Session
                                    </span>
                                }
                            </div>

                            <hr class="text-muted my-2" />

                            <!-- User Contact Details -->
                            <div class="my-3 small">
                                <div class="d-flex align-items-center mb-2 text-secondary">
                                    <i class="bi bi-envelope text-success me-2 fs-6"></i>
                                    <span class="text-break">@user.Email</span>
                                </div>
                                <div class="d-flex align-items-center text-secondary">
                                    <i class="bi bi-telephone text-success me-2 fs-6"></i>
                                    <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "No phone number" : user.PhoneNumber)</span>
                                </div>
                            </div>

                            <!-- Card Action Buttons -->
                            <div class="mt-auto pt-3 border-top d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-success flex-grow-1 fw-semibold">
                                    <i class="bi bi-pencil me-1"></i> Edit Role
                                </a>
                                @if (user.Email != User.Identity?.Name)
                                {
                                    <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger px-3">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-light text-muted border px-3" disabled>Active</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- No Matching Search Results State -->
        <div id="noMatchMessage" class="card border-0 shadow-sm rounded-3 bg-white p-5 text-center d-none mt-3">
            <div class="text-muted">
                <i class="bi bi-search text-secondary fs-1 d-block mb-2"></i>
                <h6 class="fw-bold">No Matching Users Found</h6>
                <p class="small mb-0">Try searching with a different name, email address, phone, or role.</p>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function filterUsers() {
            const query = document.getElementById('userSearchInput').value.toLowerCase().trim();
            const cards = document.querySelectorAll('.user-card');
            let visible = 0;

            cards.forEach(card => {
                const name = card.getAttribute('data-name') || '';
                const email = card.getAttribute('data-email') || '';
                const phone = card.getAttribute('data-phone') || '';
                const roles = card.getAttribute('data-roles') || '';

                if (name.includes(query) || email.includes(query) || phone.includes(query) || roles.includes(query)) {
                    card.style.display = '';
                    visible++;
                } else {
                    card.style.display = 'none';
                }
            });

            document.getElementById('visibleCount').innerText = visible;

            const noMatch = document.getElementById('noMatchMessage');
            if (noMatch) {
                if (visible === 0 && cards.length > 0) {
                    noMatch.classList.remove('d-none');
                } else {
                    noMatch.classList.add('d-none');
                }
            }
        }
    </script>
}