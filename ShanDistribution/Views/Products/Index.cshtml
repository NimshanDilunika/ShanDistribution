@model IEnumerable<ShanDistribution.Models.Product>
@{
    ViewData["Title"] = "Products";
    var productList = Model?.OrderBy(p => p.ProductName).ToList() ?? new List<ShanDistribution.Models.Product>();
}

<style>
    /* ==========================================================================
       CORPORATE PRICE LIST PRINT & PDF STYLES
       ========================================================================== */
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 12mm 15mm 15mm 15mm;
        }

        body {
            background-color: #ffffff !important;
            font-size: 11pt !important;
            color: #000000 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        /* Hide screen navigation, footers, search, buttons, and normal cards */
        nav, header, footer, .navbar, .btn, .no-print, #productCardsContainer, .card.border-start, #noMatchMessage {
            display: none !important;
        }

        /* Reveal the printable price list sheet */
        .print-only-sheet {
            display: block !important;
            width: 100% !important;
        }

        .print-table {
            width: 100% !important;
            border-collapse: collapse !important;
            margin-top: 15px !important;
        }

        .print-table th, 
        .print-table td {
            border: 1px solid #000000 !important;
            padding: 8px 12px !important;
            color: #000000 !important;
        }

        .print-table thead th {
            background-color: #f1f5f9 !important;
            font-weight: bold !important;
            text-transform: uppercase;
            font-size: 10pt;
        }

        tr {
            page-break-inside: avoid;
        }
    }

    .print-only-sheet {
        display: none;
    }
</style>

<!-- ===============================================================
     OFFICIAL PRINTABLE PRICE LIST (VISIBLE ONLY WHEN PRINTING)
     =============================================================== -->
<div class="print-only-sheet">
<!-- Corporate Letterhead Header -->
<div class="print-only mb-4 pb-3" style="border-bottom: 2px solid #000000;">
    <div class="row align-items-end">
        <div class="col-7">
            <h2 class="fw-bold mb-1" style="letter-spacing: 0.5px; text-transform: uppercase;">Shan Distribution</h2>
            <p class="mb-0 small text-muted">Islandwide Sweet &amp; Confectionery Distribution</p>
            <p class="mb-0 small text-muted">Tel: +94 77 000 0000 | Email: sales@shandistribution.com</p>
        </div>
        <div class="col-5 text-end">
            <h4 class="fw-bold mb-1 text-uppercase">Wholesale Price List</h4>
            <div class="small text-muted">
                <strong>Date:</strong> @DateTime.Now.ToString("yyyy-MM-dd HH:mm")<br />
                <strong>Effective:</strong> Immediate Dispatch
            </div>
        </div>
    </div>
</div>

    <!-- Printable Table: No | Product Name | Price -->
    <table class="print-table">
        <thead>
            <tr>
                <th style="width: 10%;" class="text-center">No</th>
                <th style="width: 60%;">Product Name</th>
                <th style="width: 30%;" class="text-end">Wholesale Price (LKR)</th>
            </tr>
        </thead>
        <tbody>
            @{
                int rowNumber = 1;
            }
            @if (!productList.Any())
            {
                <tr>
                    <td colspan="3" class="text-center py-3">No products available in the catalog.</td>
                </tr>
            }
            else
            {
                @foreach (var prod in productList)
                {
                    <tr>
                        <td class="text-center fw-semibold">@(rowNumber++)</td>
                        <td class="fw-bold">@prod.ProductName</td>
                        <td class="text-end fw-bold">@prod.Price.ToString("N2")</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="text-center text-muted small mt-4">
        <em>This price list is an official computer-generated document from ShanDistribution ERP. Prices are subject to wholesale contract terms.</em>
    </div>
</div>

<!-- ===============================================================
     STANDARD SCREEN VIEW
     =============================================================== -->
<div class="container-fluid px-0 mt-4 no-print">
    <!-- Header Banner -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white border-start border-4 border-success">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <div>
                    <h4 class="fw-bold mb-1 text-dark">
                        <i class="bi bi-boxes text-success me-2"></i>Product Catalog
                    </h4>
                    <span class="text-muted small">Manage sweet varieties, stock inventory, batch sizes, and retail pricing</span>
                </div>
                <div class="d-flex align-items-center gap-2 mt-3 mt-md-0">
                    <button type="button" onclick="printPriceList();" class="btn btn-warning fw-bold text-dark px-3 py-2">
                        <i class="bi bi-printer me-1"></i> Print Price List
                    </button>

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <a asp-action="Create" class="btn btn-success fw-semibold px-3 py-2" style="background-color: #15803d;">
                            <i class="bi bi-plus-circle me-1"></i> Add New Product
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-body p-3">
            <div class="row align-items-center g-2">
                <div class="col-12 col-md-8 col-lg-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="productSearchInput" class="form-control border-start-0 bg-light" 
                               placeholder="Search sweets by name, description, or price..." onkeyup="filterProducts()">
                    </div>
                </div>
                <div class="col-12 col-md-4 col-lg-6 text-md-end text-muted small">
                    Showing <span id="visibleCount" class="fw-bold text-dark">@(Model?.Count() ?? 0)</span> products
                </div>
            </div>
        </div>
    </div>

    <!-- Product Cards Grid -->
    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 bg-white p-5 text-center">
            <div class="text-muted">
                <i class="bi bi-boxes text-secondary fs-1 d-block mb-2"></i>
                <h6 class="fw-bold">No Products Found</h6>
                <p class="small mb-3">There are no confectionery items in the catalog yet.</p>
                <a asp-action="Create" class="btn btn-sm btn-outline-success">
                    <i class="bi bi-plus-lg me-1"></i> Add First Product
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4" id="productCardsContainer">
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-xl-4 product-card" 
                     data-name="@(item.ProductName?.ToLower() ?? "")"
                     data-description="@(item.ProductDescription?.ToLower() ?? "")"
                     data-price="@item.Price.ToString("F2")">
                    <div class="card border-0 shadow-sm rounded-3 bg-white h-100 position-relative">
                        <div class="card-body p-4 d-flex flex-column">
                            <!-- Header & Status Badge -->
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle p-3 text-white me-3" style="background-color: #14532d;">
                                        <i class="bi bi-box-seam fs-5"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-0 product-title">@item.ProductName</h5>
                                        <span class="badge bg-light text-secondary border mt-1">ID: #@item.ProductId</span>
                                    </div>
                                </div>
                                @if (item.StockCount <= 20)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 small">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Low Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                                        In Stock
                                    </span>
                                }
                            </div>

                            <!-- Description -->
                            <p class="text-muted small mb-3 flex-grow-1" style="min-height: 2.5rem;">
                                @(string.IsNullOrWhiteSpace(item.ProductDescription) ? "No description available." : item.ProductDescription)
                            </p>

                            <hr class="text-muted my-2" />

                            <!-- Inventory & Pricing Metrics -->
                            <div class="row g-2 text-center my-2">
                                <div class="col-4">
                                    <div class="p-2 rounded bg-light border">
                                        <span class="text-muted d-block" style="font-size: 0.7rem;">UNIT PRICE</span>
                                        <span class="fw-bold text-success small">LKR @item.Price.ToString("N2")</span>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-2 rounded bg-light border">
                                        <span class="text-muted d-block" style="font-size: 0.7rem;">ITEM COUNT</span>
                                        <span class="fw-bold text-dark small">@item.ItemCount Units</span>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-2 rounded bg-light border">
                                        <span class="text-muted d-block" style="font-size: 0.7rem;">STOCK</span>
                                        <span class="fw-bold @(item.StockCount <= 20 ? "text-danger" : "text-dark") small">@item.StockCount Left</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Card Action Buttons -->
                            <div class="mt-auto pt-3 border-top d-flex gap-2">
                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-success flex-grow-1 fw-semibold">
                                        <i class="bi bi-pencil me-1"></i> Edit Product
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-danger px-3">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- No Matching Search Results State -->
        <div id="noMatchMessage" class="card border-0 shadow-sm rounded-3 bg-white p-5 text-center d-none mt-3">
            <div class="text-muted">
                <i class="bi bi-search text-secondary fs-1 d-block mb-2"></i>
                <h6 class="fw-bold">No Matching Products Found</h6>
                <p class="small mb-0">Try searching with a different sweet name, description, or price.</p>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function filterProducts() {
            const query = document.getElementById('productSearchInput').value.toLowerCase().trim();
            const cards = document.querySelectorAll('.product-card');
            let visible = 0;

            cards.forEach(card => {
                const name = card.getAttribute('data-name') || '';
                const desc = card.getAttribute('data-description') || '';
                const price = card.getAttribute('data-price') || '';

                if (name.includes(query) || desc.includes(query) || price.includes(query)) {
                    card.style.display = '';
                    visible++;
                } else {
                    card.style.display = 'none';
                }
            });

            document.getElementById('visibleCount').innerText = visible;

            const noMatch = document.getElementById('noMatchMessage');
            if (noMatch) {
                if (visible === 0 && cards.length > 0) {
                    noMatch.classList.remove('d-none');
                } else {
                    noMatch.classList.add('d-none');
                }
            }
        }

        function printPriceList() {
            const originalTitle = document.title;
            const today = new Date();
            const year = today.getFullYear();
            const month = String(today.getMonth() + 1).padStart(2, '0');
            const day = String(today.getDate()).padStart(2, '0');
            
            document.title = `ShanDistribution_PriceList_${year}-${month}-${day}`;
            window.print();

            setTimeout(() => {
                document.title = originalTitle;
            }, 1000);
        }
    </script>
}