@model IEnumerable<ShanDistribution.Models.SupplierBill>
@{
    ViewData["Title"] = "Supplier Bills";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-success"><i class="bi bi-file-earmark-text"></i> Supplier Bills</h2>
        <a asp-action="Create" class="btn btn-success">+ Add Supplier Bill</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Bill No</th>
                        <th>Supplier Name</th>
                        <th>Date</th>
                        <th class="text-end">Total Amount (LKR)</th>
                        <th class="text-end">Paid Amount (LKR)</th>
                        <th class="text-end">Balance Amount (LKR)</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No supplier bills recorded yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var bill in Model)
                        {
                            <tr>
                                <td class="fw-bold">@bill.BillNo</td>
                                <td>@bill.SupplierName</td>
                                <td>@bill.Date.ToString("yyyy-MM-dd")</td>
                                <td class="fw-bold text-dark text-end">@bill.TotalAmount.ToString("N2")</td>
                                <td class="text-success fw-bold text-end">@bill.PaidAmount.ToString("N2")</td>
                                <td class="text-danger fw-bold text-end">
                                    @if (bill.BalanceAmount < 0)
                                    {
                                        <span>(@Math.Abs(bill.BalanceAmount).ToString("N2"))</span>
                                    }
                                    else
                                    {
                                        <span>@bill.BalanceAmount.ToString("N2")</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (bill.Status == "Complete")
                                    {
                                        <span class="badge bg-success">Complete</span>
                                    }
                                    else if (bill.Status == "Balance")
                                    {
                                        <span class="badge bg-warning text-dark">Balance</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Initial</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@bill.SBId" class="btn btn-sm btn-outline-success">View Details</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>