@model ShanDistribution.Models.Supplier
@{
    ViewData["Title"] = "Supplier Details - " + Model.SupplierName;
    var bills = ViewBag.Bills as List<ShanDistribution.Models.SupplierBill> ?? new List<ShanDistribution.Models.SupplierBill>();
    decimal totalBilled = bills.Sum(b => b.TotalAmount);
    decimal totalPaid = bills.Sum(b => b.PaidAmount);
    decimal totalBalance = bills.Sum(b => b.BalanceAmount);
}

<style>
    /* ==========================================================================
       CORPORATE PRINT & PDF STYLES
       ========================================================================== */
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 12mm 15mm 15mm 15mm;
        }

        body {
            background-color: #ffffff !important;
            font-size: 11pt !important;
            color: #000000 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        /* Hide interactive screen UI */
        nav, header, footer, .navbar, .btn, .no-print {
            display: none !important;
        }

        /* Reveal official statement print blocks */
        .print-only {
            display: block !important;
        }

        .container {
            width: 100% !important;
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
        }

        .card-body {
            padding: 0 !important;
        }

        .table-responsive {
            overflow: visible !important;
        }

        .table {
            border-collapse: collapse !important;
            width: 100% !important;
            margin-top: 15px !important;
        }

        .table-bordered th, 
        .table-bordered td {
            border: 1px solid #000000 !important;
            padding: 8px 10px !important;
        }

        .table-dark {
            background-color: #f1f5f9 !important;
            color: #000000 !important;
        }

        .badge {
            border: 1px solid #000000 !important;
            background: transparent !important;
            color: #000000 !important;
        }

        tr {
            page-break-inside: avoid;
        }
    }

    .print-only {
        display: none;
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm border-0 mb-4">
        
        <!-- Screen Header -->
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center no-print">
            <h4 class="mb-0"><i class="bi bi-truck"></i> @Model.SupplierName</h4>
            <div>
                <button type="button" onclick="printSupplierStatement('@Model.SupplierName');" class="btn btn-warning btn-sm text-dark fw-bold me-2">
                    <i class="bi bi-printer"></i> Print / Download PDF
                </button>
                <a asp-action="Index" class="btn btn-outline-light btn-sm">
                    Back to Supplier List
                </a>
            </div>
        </div>

        <div class="card-body p-4">

            <!-- ===============================================================
                 CORPORATE REPORT LETTERHEAD (PRINT / PDF ONLY)
                 =============================================================== -->
            <div class="print-only mb-4 pb-3" style="border-bottom: 2px solid #000000;">
                <div class="row align-items-end">
                    <div class="col-7">
                        <h2 class="fw-bold mb-1" style="letter-spacing: 0.5px; text-transform: uppercase;">Shan Distribution</h2>
                        <p class="mb-0 small text-muted">Islandwide Sweet &amp; Confectionery Distribution</p>
                        <p class="mb-0 small text-muted">Tel: +94 77 000 0000 | Email: accounts@shandistribution.com</p>
                    </div>
                    <div class="col-5 text-end">
                        <h4 class="fw-bold mb-1 text-uppercase">Supplier Statement</h4>
                        <div class="small text-muted">
                            <strong>Date:</strong> @DateTime.Now.ToString("yyyy-MM-dd HH:mm")<br />
                            <strong>Prepared By:</strong> @(User.Identity?.Name ?? "Admin")
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===============================================================
                 SUPPLIER PROFILE & FINANCIAL SUMMARY
                 =============================================================== -->
            <div class="row g-3 mb-4">
                <div class="col-md-6 col-6">
                    <div class="p-3 bg-light rounded border h-100">
                        <h6 class="text-success fw-bold mb-3 border-bottom pb-2">Supplier Profile</h6>
                        <p class="mb-1"><strong>Account Ref:</strong> SUP-@Model.SupplierId.ToString("D4")</p>
                        <p class="mb-1"><strong>Name:</strong> @Model.SupplierName</p>
                        <p class="mb-1"><strong>Address:</strong> @(string.IsNullOrWhiteSpace(Model.Address) ? "N/A" : Model.Address)</p>
                        <p class="mb-0"><strong>Phone:</strong> @(string.IsNullOrWhiteSpace(Model.PhoneNo) ? "N/A" : Model.PhoneNo)</p>
                    </div>
                </div>

                <div class="col-md-6 col-6">
                    <div class="p-3 bg-light rounded border h-100">
                        <h6 class="text-success fw-bold mb-3 border-bottom pb-2">Financial Summary</h6>
                        <div class="d-flex justify-content-between mb-1">
                            <span>Total Billed:</span>
                            <span class="fw-bold text-nowrap">LKR @totalBilled.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1 text-success">
                            <span>Total Paid:</span>
                            <span class="fw-bold text-nowrap">LKR @totalPaid.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between text-danger pt-1 border-top">
                            <span>Total Outstanding Balance:</span>
                            <span class="fw-bold text-nowrap">
                                @if (totalBalance < 0)
                                {
                                    <span>(LKR @Math.Abs(totalBalance).ToString("N2"))</span>
                                }
                                else
                                {
                                    <span>LKR @totalBalance.ToString("N2")</span>
                                }
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===============================================================
                 SUPPLIER BILLS LIST
                 =============================================================== -->
            <h5 class="text-success mb-3">
                <i class="bi bi-file-earmark-text"></i> Bill History
            </h5>

            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 border">
                    <thead class="table-dark">
                        <tr>
                            <th>Bill No</th>
                            <th>Date</th>
                            <th class="text-end">Total Amount (LKR)</th>
                            <th class="text-end">Paid Amount (LKR)</th>
                            <th class="text-end">Balance Amount (LKR)</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!bills.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No bills recorded for this supplier.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var bill in bills)
                            {
                                <tr>
                                    <td class="fw-bold">@bill.BillNo</td>
                                    <td>@bill.Date.ToString("yyyy-MM-dd")</td>
                                    <td class="fw-bold text-dark text-end">@bill.TotalAmount.ToString("N2")</td>
                                    <td class="text-success fw-bold text-end">@bill.PaidAmount.ToString("N2")</td>
                                    <td class="text-danger fw-bold text-end">
                                        @if (bill.BalanceAmount < 0)
                                        {
                                            <span>( @Math.Abs(bill.BalanceAmount).ToString("N2"))</span>
                                        }
                                        else
                                        {
                                            <span> @bill.BalanceAmount.ToString("N2")</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(bill.Status == "Complete" ? "bg-success" : bill.Status == "Balance" ? "bg-warning text-dark" : "bg-secondary")">
                                            @bill.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold bg-light">
                            <td colspan="2" class="text-end text-uppercase">Summary Totals:</td>
                            <td class="text-end"> @totalBilled.ToString("N2")</td>
                            <td class="text-end text-success"> @totalPaid.ToString("N2")</td>
                            <td class="text-end text-danger">
                                @if (totalBalance < 0)
                                {
                                    <span>( @Math.Abs(totalBalance).ToString("N2"))</span>
                                }
                                else
                                {
                                    <span>@totalBalance.ToString("N2")</span>
                                }
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- ===============================================================
                 CORPORATE SIGN-OFF BLOCK (PRINT / PDF ONLY)
                 =============================================================== -->
            <div class="print-only mt-5 pt-4">
                <div class="row text-center">
                    <div class="col-4">
                        <div style="border-top: 1px solid #000; width: 75%; margin: 35px auto 5px auto;"></div>
                        <span class="small text-uppercase fw-bold">Prepared By</span>
                    </div>
                    <div class="col-4">
                        <div style="border-top: 1px solid #000; width: 75%; margin: 35px auto 5px auto;"></div>
                        <span class="small text-uppercase fw-bold">Accounts Dept</span>
                    </div>
                    <div class="col-4">
                        <div style="border-top: 1px solid #000; width: 75%; margin: 35px auto 5px auto;"></div>
                        <span class="small text-uppercase fw-bold">Authorized Signatory</span>
                    </div>
                </div>
                <div class="text-center text-muted small mt-4">
                    <em>This ledger statement is an official computer-generated document from Shan Distribution ERP.</em>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function printSupplierStatement(supplierName) {
            const originalTitle = document.title;
            const today = new Date();
            const year = today.getFullYear();
            const month = String(today.getMonth() + 1).padStart(2, '0');
            const day = String(today.getDate()).padStart(2, '0');
            const formattedDate = `${year}-${month}-${day}`;
            
            const cleanName = supplierName.replace(/[^a-zA-Z0-9]/g, '_');
            document.title = `Supplier_${cleanName}_${formattedDate}`;

            window.print();

            setTimeout(() => {
                document.title = originalTitle;
            }, 1000);
        }
    </script>
}