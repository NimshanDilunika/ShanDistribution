@model ShanDistribution.Models.CustomerInvoice
@{
    ViewData["Title"] = "Invoice Details - " + (string.IsNullOrWhiteSpace(Model.InvoiceNo) ? "Invoice" : Model.InvoiceNo);
}

<style>
    /* ==========================================================================
       A4 OFFICIAL INVOICE PRINT & PDF STYLES
       ========================================================================== */
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 12mm 15mm 15mm 15mm;
        }

        body {
            background-color: #ffffff !important;
            font-size: 11pt !important;
            color: #000000 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        /* Hide screen UI, navigation, buttons, and normal screen cards */
        nav, header, footer, .navbar, .btn, .no-print, .screen-only-card {
            display: none !important;
        }

        /* Display print-ready invoice layout */
        .print-invoice-sheet {
            display: block !important;
            width: 100% !important;
        }

        .print-table {
            width: 100% !important;
            border-collapse: collapse !important;
            margin-top: 15px !important;
        }

        .print-table th, 
        .print-table td {
            border: 1px solid #000000 !important;
            padding: 7px 10px !important;
            color: #000000 !important;
        }

        .print-table thead th {
            background-color: #f1f5f9 !important;
            font-weight: bold !important;
            text-transform: uppercase;
            font-size: 9.5pt;
        }

        .badge {
            border: 1px solid #000000 !important;
            background: transparent !important;
            color: #000000 !important;
        }

        tr {
            page-break-inside: avoid;
        }
    }

    .print-invoice-sheet {
        display: none;
    }
</style>

<!-- ===============================================================
     OFFICIAL PRINTABLE INVOICE (VISIBLE ONLY WHEN PRINTING)
     =============================================================== -->
<div class="print-invoice-sheet">
    <!-- Corporate Header -->
<!-- Corporate Header -->
<!-- Corporate Letterhead Header -->
<div class="print-only mb-4 pb-3" style="border-bottom: 2px solid #000000;">
    <div class="row align-items-end">
        <div class="col-7">
            <h2 class="fw-bold mb-1" style="letter-spacing: 0.5px; text-transform: uppercase;">Shan Distribution</h2>
            <p class="mb-0 small text-muted">Islandwide Sweet &amp; Confectionery Distribution</p>
            <p class="mb-0 small text-muted">Tel: +94 77 000 0000 | Email: billing@shandistribution.com</p>
        </div>
        <div class="col-5 text-end">
            <h4 class="fw-bold mb-1 text-uppercase">Invoice </h4>
            <div class="small text-muted">
                <strong>Invoice No:</strong> @Model.InvoiceNo<br />
                <strong>Date:</strong> @Model.Date.ToString("yyyy-MM-dd")<br />
                <strong>Status:</strong> @Model.Status
            </div>
        </div>
    </div>
</div>
    <!-- Bill To / Customer Details & Financial Summary -->
<div class="row g-2 mb-3 align-items-stretch" style="font-size: 9.5pt;">
    <!-- Billed To (Left) -->
    <div class="col-6">
        <div class="p-2 px-3 border rounded h-100 bg-light-subtle d-flex flex-column justify-content-center">
            <span class="text-uppercase text-muted fw-bold mb-1" style="font-size: 8pt; letter-spacing: 0.5px;">Billed To:</span>
            <div class="fw-bold text-dark fs-6 text-truncate">@Model.CustomerName</div>
            <span class="text-muted small">Official Store Account &bull; Customer #@Model.CustomerId</span>
        </div>
    </div>

    <!-- Financial Summary (Right) -->
    <div class="col-6">
        <div class="p-2 px-3 border rounded h-100 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted">Gross Amount:</span>
                <span class="fw-semibold text-nowrap">LKR @Model.Amount.ToString("N2")</span>
            </div>
            
            <div class="d-flex justify-content-between align-items-center mb-1 text-danger">
                <span>Discount Allowed:</span>
                <span class="fw-semibold text-nowrap">- LKR @Model.Discount.ToString("N2")</span>
            </div>

            <div class="d-flex justify-content-between align-items-center py-1 border-top border-bottom my-1 bg-light px-2 rounded">
                <span class="fw-bold text-dark">Net Invoice Total:</span>
                <span class="fw-bold text-dark text-nowrap">LKR @Model.TotalAmount.ToString("N2")</span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-1 text-success">
                <span>Total Paid:</span>
                <span class="fw-semibold text-nowrap">LKR @Model.PaidAmount.ToString("N2")</span>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-1 border-top">
                <span class="fw-bold text-danger">Outstanding Due:</span>
                <span class="fw-bold text-danger text-nowrap">
                    LKR @(Model.BalanceAmount < 0 ? $"({Math.Abs(Model.BalanceAmount):N2})" : Model.BalanceAmount.ToString("N2"))
                </span>
            </div>
        </div>
    </div>
</div>

    <!-- Product Line Items -->
    <table class="print-table mb-4">
        <thead>
            <tr>
                <th style="width: 50%;">Product Description</th>
                <th style="width: 15%;" class="text-end">Unit Price</th>
                <th style="width: 15%;" class="text-center">Quantity</th>
                <th style="width: 20%;" class="text-end">Total Price (LKR)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.InvoiceProducts)
            {
                <tr>
                    <td class="fw-semibold">@p.ProductName</td>
                    <td class="text-end">@p.Price.ToString("N2")</td>
                    <td class="text-center">@p.Count</td>
                    <td class="text-end fw-bold">@p.TotalPrice.ToString("N2")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-end fw-bold">Subtotal Amount:</td>
                <td class="text-end fw-bold">@Model.Amount.ToString("N2")</td>
            </tr>
            <tr>
                <td colspan="3" class="text-end fw-bold text-danger">Applied Discount:</td>
                <td class="text-end fw-bold text-danger">- @Model.Discount.ToString("N2")</td>
            </tr>
            <tr style="background-color: #f8fafc;">
                <td colspan="3" class="text-end fw-bold text-uppercase">Net Total Payable:</td>
                <td class="text-end fw-bold fs-6">@Model.TotalAmount.ToString("N2")</td>
            </tr>
        </tfoot>
    </table>

    <!-- Payment Breakdown -->
    @if (Model.InvoicePayments != null && Model.InvoicePayments.Any())
    {
        <h6 class="fw-bold text-uppercase mb-2" style="font-size: 10pt;">Receipted Payments</h6>
        <table class="print-table mb-4">
            <thead>
                <tr>
                    <th style="width: 60%;">Payment Date</th>
                    <th style="width: 40%;" class="text-end">Amount Paid (LKR)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pay in Model.InvoicePayments.OrderBy(p => p.Date))
                {
                    <tr>
                        <td>@pay.Date.ToString("yyyy-MM-dd")</td>
                        <td class="text-end fw-bold">@pay.Payment.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <!-- Sign-off Block -->
    <div class="mt-5 pt-3">
        <div class="row text-center">
            <div class="col-6">
                <div style="border-top: 1px solid #000; width: 65%; margin: 35px auto 5px auto;"></div>
                <span class="small text-uppercase fw-bold">Customer Acknowledgment (Sign & Stamp)</span>
            </div>
            <div class="col-6">
                <div style="border-top: 1px solid #000; width: 65%; margin: 35px auto 5px auto;"></div>
                <span class="small text-uppercase fw-bold">Authorized Dispatch Officer</span>
            </div>
        </div>
        <div class="text-center text-muted small mt-4">
            <em>Thank you for your business! ShanDistribution ERP generated document.</em>
        </div>
    </div>
</div>

<!-- ===============================================================
     STANDARD SCREEN VIEW
     =============================================================== -->
<div class="container mt-4 screen-only-card no-print">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-success text-white d-flex flex-wrap justify-content-between align-items-center py-3">
            <h4 class="mb-0 fw-bold">
                <i class="bi bi-receipt me-2"></i>@Model.CustomerName | @Model.InvoiceNo
            </h4>
            <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                <button type="button" onclick="printInvoice();" class="btn btn-warning btn-sm text-dark fw-bold">
                    <i class="bi bi-printer me-1"></i> Print Invoice
                </button>

                @if (Model.Status != "Complete")
                {
                    <a asp-action="Payment" asp-route-id="@Model.CIId" class="btn btn-light btn-sm text-success fw-bold">
                        <i class="bi bi-credit-card me-1"></i> Make Payment
                    </a>
                }
                <a asp-action="Index" class="btn btn-outline-light btn-sm">Back to List</a>
            </div>
        </div>

        <div class="card-body p-4">
            <!-- Summary & Status Header -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border h-100">
                        <p class="mb-2"><strong>Customer:</strong> @Model.CustomerName</p>
                        <p class="mb-0"><strong>Invoice No:</strong> @Model.InvoiceNo</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border h-100">
                        <p class="mb-2"><strong>Issue Date:</strong> @Model.Date.ToString("yyyy-MM-dd")</p>
                        <p class="mb-0 d-flex align-items-center gap-2">
                            <strong>Status:</strong>
                            @if (Model.Status == "Complete")
                            {
                                <span class="badge bg-success">Complete</span>
                            }
                            else if (Model.Status == "Balance")
                            {
                                <span class="badge bg-warning text-dark">Balance</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Initial</span>
                            }
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <ul class="list-group shadow-sm">
                        <li class="list-group-item d-flex justify-content-between py-1 small">
                            <span>Subtotal Amount:</span> <strong class="text-dark">LKR @Model.Amount.ToString("N2")</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-1 small text-danger">
                            <span>Discount:</span> <strong>- LKR @Model.Discount.ToString("N2")</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2">
                            <span>Net Total:</span> <strong class="text-dark">LKR @Model.TotalAmount.ToString("N2")</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-1 small text-success">
                            <span>Paid Amount:</span> <strong class="fw-bold">LKR @Model.PaidAmount.ToString("N2")</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-1 small text-danger">
                            <span>Balance Due:</span>
                            <strong class="fw-bold">
                                LKR @(Model.BalanceAmount < 0 ? $"({Math.Abs(Model.BalanceAmount):N2})" : Model.BalanceAmount.ToString("N2"))
                            </strong>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Sold Products Table -->
            <h5 class="mb-3 text-success fw-bold">
                <i class="bi bi-boxes me-1"></i> Sold Products
            </h5>
            <div class="table-responsive mb-4">
                <table class="table table-bordered table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Product Name</th>
                            <th class="text-end">Price</th>
                            <th class="text-center">Count</th>
                            <th class="text-end">Total Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.InvoiceProducts)
                        {
                            <tr>
                                <td class="fw-semibold">@p.ProductName</td>
                                <td class="text-end">LKR @p.Price.ToString("N2")</td>
                                <td class="text-center">@p.Count</td>
                                <td class="text-end fw-bold">LKR @p.TotalPrice.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Payment History Table -->
            <h5 class="mb-3 text-success fw-bold">
                <i class="bi bi-clock-history me-1"></i> Payment History
            </h5>
            @if (Model.InvoicePayments != null && Model.InvoicePayments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0">
                        <thead class="table-secondary">
                            <tr>
                                <th>Payment Date</th>
                                <th class="text-end">Paid Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pay in Model.InvoicePayments.OrderByDescending(p => p.Date))
                            {
                                <tr>
                                    <td>@pay.Date.ToString("yyyy-MM-dd")</td>
                                    <td class="fw-bold text-success text-end">LKR @pay.Payment.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-light border text-muted mb-0">
                    <i class="bi bi-info-circle me-1"></i> No payments recorded for this invoice yet.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function printInvoice() {
            const originalTitle = document.title;
            const invoiceNo = '@(string.IsNullOrWhiteSpace(Model.InvoiceNo) ? "Invoice" : Model.InvoiceNo.Replace(" ", "_"))';
            
            document.title = `Invoice_${invoiceNo}`;
            window.print();

            setTimeout(() => {
                document.title = originalTitle;
            }, 1000);
        }
    </script>
}