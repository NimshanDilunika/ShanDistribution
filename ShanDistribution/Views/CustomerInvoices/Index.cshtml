@model IEnumerable<ShanDistribution.Models.CustomerInvoice>
@{
    ViewData["Title"] = "Customer Invoices";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-success"><i class="bi bi-file-earmark-text"></i> Customer Invoices</h2>
        <a asp-action="Create" class="btn btn-success">+ Create New Invoice</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Invoice No</th>
                            <th>Customer Name</th>
                            <th>Date</th>
                            <th class="text-end">Total Amount (LKR)</th>
                            <th class="text-end">Paid Amount (LKR)</th>
                            <th class="text-end">Balance Amount (LKR)</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">No customer invoices recorded yet.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var inv in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@inv.InvoiceNo</td>
                                    <td>@inv.CustomerName</td>
                                    <td>@inv.Date.ToString("yyyy-MM-dd")</td>
                                    <td class="fw-bold text-dark text-end">@inv.TotalAmount.ToString("N2")</td>
                                    <td class="text-success fw-bold text-end">@inv.PaidAmount.ToString("N2")</td>
                                    <td class="text-danger fw-bold text-end">
                                        @if (inv.BalanceAmount < 0)
                                        {
                                            <span>(@Math.Abs(inv.BalanceAmount).ToString("N2"))</span>
                                        }
                                        else
                                        {
                                            <span>@inv.BalanceAmount.ToString("N2")</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (inv.Status == "Complete")
                                        {
                                            <span class="badge bg-success">Complete</span>
                                        }
                                        else if (inv.Status == "Balance")
                                        {
                                            <span class="badge bg-warning text-dark">Balance</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Initial</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@inv.CIId" class="btn btn-sm btn-outline-success">View Details</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>